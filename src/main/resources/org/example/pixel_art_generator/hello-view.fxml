<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.pixel_art_generator.HelloController">
    <top>
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="0.0"/>
            </padding>

            <Label fx:id="welcomeText"/>
            <Button text="Open File" onAction="#onOpenButtonClick" fx:id="Open"/>
            <Button text="New Art" onAction="#onNewButtonClick" fx:id="New"/>
            <Button text="Save Art" onAction="#onSaveButtonClick" fx:id="Save" visible="false"/>
            <Button text="Create Animated Art" onAction="#onAnimaButtonClick" fx:id="Anima" visible="false"/>
            <TextField text="Frame Name:" editable="true" visible="false" fx:id="FrameName"/>
        </VBox>
    </top>
    <center>
        <GridPane  scaleX="1.7" scaleY="1.07" hgap="0" vgap="0" alignment="CENTER" fx:id="Grid">
            <Button text=" /\ " minWidth="257" onAction="#onUpButtonClick" fx:id="Up"  GridPane.columnIndex="1" GridPane.columnSpan="18" GridPane.rowIndex="0">
                <visible>false</visible>
            </Button>
            <Button text="&lt;" minHeight="400" onAction="#onLeftButtonClick" fx:id="Left" GridPane.columnIndex="0" GridPane.rowSpan="17" GridPane.rowIndex="1">
                <visible>false</visible>
            </Button>
            <Button text=" \/ " minWidth="257" onAction="#onDownButtonClick" fx:id="Down" GridPane.columnIndex="1" GridPane.columnSpan="18" GridPane.rowIndex="18">
                <visible>false</visible>
            </Button>
            <Button text="&gt;" minHeight="400"  onAction="#onRightButtonClick" fx:id="Right" GridPane.columnIndex="18" GridPane.rowSpan="17"  GridPane.rowIndex="1">
                <visible>false</visible>
            </Button>


        </GridPane>
    </center>
    <right>
        <HBox alignment="CENTER" spacing="20.0">
            <ColorPicker fx:id="Colour" visible="false"/>
        </HBox>
    </right>
</BorderPane>

